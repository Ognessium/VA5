# ============================================================
# VoiceAgentV5 — Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ============================================================

# Google AI Studio API Key
# Used for: Reasoning model (gemini-3.5-flash-lite) + V2V Talker (gemini-3.1-flash-live-preview)
# How to get: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# LiveKit Cloud Credentials
# How to get: https://cloud.livekit.io → Your Project → Settings → Keys
LIVEKIT_URL=wss://your-project-name.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Optional: Voice for the Talker model
# Options: Puck, Charon, Kore, Fenrir, Aoede
# GOOGLE_VOICE=Puck
# GOOGLE_VOICE=Puck

# Optional: Local fallback model (if Ollama is installed and running)
# OLLAMA_FALLBACK_MODEL=qwen2.5:7b-instruct
